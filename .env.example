# SceneSense Configuration
# ========================

# Server Port (default 5000)
PORT=5000
NODE_ENV=development

# AI Provider Selection
# Options: "local" (default offline zero-key mode) | "openai" | "gemini"
AI_PROVIDER=local

# Optional External API Keys (Only needed if AI_PROVIDER != local)
# Do NOT commit actual API keys to git.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Client Configuration
VITE_API_URL=http://localhost:5000/api
